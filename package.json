{
  "name": "calculus-workbench-v7",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "V7 高等数学 AI 学习工作台",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node app/build/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "acceptance": "tsx automation/acceptance.ts",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File automation/Package-Windows.ps1",
    "maintenance": "node automation/maintenance.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "express": "^5.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
